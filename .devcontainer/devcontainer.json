{
  "name": "ReadySet Control Tower",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "forwardPorts": [
    8010
  ],
  "portsAttributes": {
    "8010": {
      "label": "ReadySet Control Tower",
      "onAutoForward": "openBrowser"
    }
  },
  "postAttachCommand": "curl -s -o /dev/null localhost:8010/api/health || python3 -m control_tower serve --no-open"
}
